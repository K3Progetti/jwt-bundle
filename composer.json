{
  "name": "k3progetti/jwt-bundle",
  "description": "Bundle Symfony per la gestione dei token JWT con supporto a refresh token e logout",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Mattia Vitali",
      "email": "vitali.mattia@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "firebase/php-jwt": "^7.0.3",
    "nesbot/carbon": "~3.0",
    "doctrine/orm": "^3.6.2",
    "doctrine/doctrine-bundle": "^3.2.2",
    "symfony/framework-bundle": "~8.0",
    "symfony/http-client": "~8.0",
    "symfony/messenger": "~8.0",
    "symfony/redis-messenger": "~8.0",
    "symfony/validator": "~8.0",
    "symfony/security-bundle": "~8.0",
    "symfony/serializer": "~8.0",
    "k3progetti/mercure-bridge-bundle": "*",
    "k3progetti/doctrine-repository": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "K3Progetti\\JwtBundle\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
