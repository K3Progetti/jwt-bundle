# Configurazione per la login
jwt:
  secret_key: '%env(JWT_PASSPHRASE)%'
  token_ttl: 3600            # Scadenza del token in secondi (1 ora)
  refresh_token_ttl: 2592000 # Scadenza del token di refresh in secondi (30 giorni)
  algorithm: 'HS256'         # Default HS256
  time_zone: 'Europe/Rome'   # Default Europe/Rome
  2fa_expired_code: 10       # Validità codice 2FA in minuti
  user_class: 'App\Entity\User'
  user_repository_class: 'App\Repository\UserRepository'
  # mailer_class: 'App\Service\External\PostmarkService'  # Richiesto solo se si usa il 2FA